<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xxx.CommComboMapper">

    <!--
        [기존] 콤보 1개 조회 - 다른 화면에서 사용 중이므로 그대로 유지
    -->
    <select id="selectCommCombo" parameterType="map" resultType="map">
        <!-- ... 기존 쿼리 그대로 ... -->
    </select>

    <!--
        [신규] 콤보 여러 개 일괄 조회 (aaa014 등)
        - 프론트에서 COMBO_DEFS 배열을 넘기면 foreach가 SELECT를 UNION ALL로 이어서 쿼리 1개로 실행
        - 기존 쿼리를 복사해서 아래 규칙대로 수정
            1) 파라미터 앞에 def. 붙이기 (#{CD_DIV} → #{def.CD_DIV}, ${TABLENM} → ${def.TABLENM}, if test 안도 포함)
            2) COMBO_TP, PRNT_CD 컬럼 추가
            3) 안쪽 ORDER BY 제거 (UNION 안에서는 에러) → 바깥에서 한 번만 정렬
        - WHERE 조건은 예시. 기존 쿼리 조건으로 교체할 것
    -->
    <select id="selectCommComboList" parameterType="list" resultType="map">
        SELECT COMBO_TP
             , CD
             , NM
             , PRNT_CD
          FROM (
            <foreach collection="list" item="def" separator="UNION ALL">
                SELECT #{def.COMBO_TP}  AS COMBO_TP
                     , ${def.COLUMN0}   AS CD
                     , ${def.COLUMN1}  AS NM
                <choose>
                    <when test="def.PRNT_COLUMN != null and def.PRNT_COLUMN != ''">
                     , ${def.PRNT_COLUMN} AS PRNT_CD
                    </when>
                    <otherwise>
                     , NULL AS PRNT_CD
                    </otherwise>
                </choose>
                  FROM ${def.TABLENM}
                 WHERE 1 = 1
                <!-- family 조건: a~h에만 들어감 (family 목록 정의에는 FAMILY_CD 없음). 컬럼명은 실제 값으로 교체 -->
                <if test="def.FAMILY_CD != null and def.FAMILY_CD != ''">
                   AND FAMILY_CD = #{def.FAMILY_CD}
                </if>
                <if test="def.GTS_TYP_CD != null and def.GTS_TYP_CD != ''">
                   AND GTS_TYP_CD = #{def.GTS_TYP_CD}
                </if>
                <if test="def.SYS_TYP_CD != null and def.SYS_TYP_CD != ''">
                   AND SYS_TYP_CD = #{def.SYS_TYP_CD}
                </if>
                <if test="def.CD_DIV != null and def.CD_DIV != ''">
                   AND CD_DIV = #{def.CD_DIV}
                </if>
                ${def.IN_CONT}
            </foreach>
          )
         ORDER BY COMBO_TP, CD
    </select>

</mapper>
