<!--
  arrDimList 항목 중 dim_cols 값이 있는 것만 || '^' || 값 으로 이어 붙임 (iBATIS 2.x)
  - 리스트가 비어 있거나 [{dim_cols=}] 처럼 값이 빈 항목만 있으면 아무것도 안 들어감
-->
<isNotEmpty property="arrDimList">
    <iterate property="arrDimList">
        <isNotEmpty property="arrDimList[].dim_cols">
            || '^' || $arrDimList[].dim_cols$
        </isNotEmpty>
    </iterate>
</isNotEmpty>
