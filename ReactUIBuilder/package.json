{
  "name": "react-ui-builder-offline",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "완전 오프라인 React 프로젝트 분석 및 UI Builder",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "test": "node --test tests/*.test.mjs",
    "build:renderer": "vite build",
    "build:win": "npm run build:renderer && electron-builder --win portable",
    "build:win:dir": "npm run build:renderer && electron-builder --win dir"
  },
  "dependencies": {
    "@babel/parser": "^7.28.4",
    "@babel/traverse": "^7.28.4",
    "chokidar": "^4.0.3",
    "esbuild-wasm": "^0.25.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.7",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "local.reactuibuilder",
    "productName": "React UI Builder",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/core/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "ReactUIBuilder-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "ReactUIBuilder-${version}-portable.${ext}"
    }
  }
}
